# syntax=docker/dockerfile:1.7
FROM docker.m.daocloud.io/library/python:3.13-slim AS build

ARG UV_VERSION=0.11.8
ENV UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    UV_EXTRA_INDEX_URL= \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app

RUN pip install --no-cache-dir --index-url https://mirrors.aliyun.com/pypi/simple/ "uv==${UV_VERSION}"

# Keep dependency installation in a code-independent layer. The server can
# reuse this large Docling/PyTorch layer when only application code changes.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY backend ./backend
RUN uv sync --frozen --no-dev

FROM docker.m.daocloud.io/library/python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY --from=build /app/backend /app/backend

EXPOSE 9900
CMD ["oncall-api"]
