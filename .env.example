ONCALL_ENV=development
ONCALL_HOST=127.0.0.1
ONCALL_PORT=9900
ONCALL_LOG_LEVEL=INFO
ONCALL_DATABASE_URL=postgresql+asyncpg://oncall:oncall@127.0.0.1:5432/oncall
ONCALL_LANGGRAPH_DATABASE_URL=postgresql://oncall:oncall@127.0.0.1:5432/oncall
ONCALL_MILVUS_URI=http://127.0.0.1:19530
ONCALL_MILVUS_TOKEN=root:Milvus
ONCALL_DATA_DIR=./data
ONCALL_SECRET_MASTER_KEY=
ONCALL_ADMIN_USERNAME=admin
ONCALL_ADMIN_PASSWORD=change-me-now
ONCALL_MODEL_PROVIDER=mock
ONCALL_MODEL_BASE_URL=https://api.openai.com/v1
ONCALL_MODEL_API_KEY=
ONCALL_MODEL_NAME=gpt-4.1-mini
ONCALL_EMBEDDING_BASE_URL=
ONCALL_EMBEDDING_API_KEY=
ONCALL_EMBEDDING_MODEL=text-embedding-3-small
ONCALL_EMBEDDING_DIMENSION=1536
ONCALL_RERANK_BASE_URL=
ONCALL_RERANK_API_KEY=
ONCALL_RERANK_MODEL=
ONCALL_FEISHU_ENABLED=false
ONCALL_FEISHU_APP_ID=
ONCALL_FEISHU_APP_SECRET=
ONCALL_FEISHU_DEFAULT_RECEIVE_ID=
ONCALL_FEISHU_DEFAULT_RECEIVE_ID_TYPE=chat_id
ONCALL_FEISHU_WS_INITIAL_RETRY_SECONDS=2
ONCALL_FEISHU_WS_MAX_RETRY_SECONDS=120
ONCALL_FEISHU_EVENT_CLAIM_SECONDS=300
ONCALL_FEISHU_EVENT_MAX_ATTEMPTS=5
ONCALL_FEISHU_OUTBOX_CLAIM_SECONDS=300
ONCALL_WEB_ORIGIN=http://127.0.0.1:5173
ONCALL_MONITOR_DEFAULT_INTERVAL_SECONDS=300
ONCALL_METRIC_RETENTION_DAYS=30

ONCALL_INCIDENT_STALE_REINVESTIGATE_SECONDS=3600
ONCALL_NOTIFICATION_COOLDOWN_SECONDS=1800
ONCALL_KNOWLEDGE_MAX_UPLOAD_MB=50
ONCALL_SESSION_DAYS=30
ONCALL_JOB_LEASE_SECONDS=120
ONCALL_JOB_POLL_SECONDS=1.0
ONCALL_LANGGRAPH_STRICT_MSGPACK=true
# LangGraph checkpoint security hardening (read by langgraph-checkpoint-postgres when supported)
LANGGRAPH_STRICT_MSGPACK=true

# Bump this when Milvus schema/embedding semantics change; rebuild the index afterward.
ONCALL_KNOWLEDGE_INDEX_VERSION=v1
