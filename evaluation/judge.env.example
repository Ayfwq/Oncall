# Copy to .env.ragas at the repository root (gitignored).
# Set all three to use an independent OpenAI-compatible judge.
# If all are blank, the configured application model is used with a separate client.
RAGAS_JUDGE_MODEL=
RAGAS_JUDGE_BASE_URL=
RAGAS_JUDGE_API_KEY=
# Optional independent embeddings for answer relevancy; blank uses application configuration.
RAGAS_EMBEDDING_MODEL=
RAGAS_EMBEDDING_BASE_URL=
RAGAS_EMBEDDING_API_KEY=
RAGAS_TIMEOUT=120
RAGAS_MAX_RETRIES=2
RAGAS_DO_NOT_TRACK=true
