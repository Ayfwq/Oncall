# Copy to .env on the server. Never commit the real .env file.
ONCALL_ENV=production
ONCALL_HOST=0.0.0.0
ONCALL_PORT=9900
ONCALL_LOG_LEVEL=INFO
ONCALL_DATA_DIR=/app/data
ONCALL_SECRET_MASTER_KEY=replace-with-a-long-random-secret
ONCALL_ADMIN_USERNAME=admin
ONCALL_ADMIN_PASSWORD=replace-with-a-strong-password
ONCALL_MODEL_PROVIDER=mock
ONCALL_MODEL_BASE_URL=https://api.openai.com/v1
ONCALL_MODEL_API_KEY=
ONCALL_MODEL_NAME=gpt-4.1-mini
ONCALL_WEB_ORIGIN=http://8.138.47.45:3000
ONCALL_FEISHU_ENABLED=false
ONCALL_FEISHU_APP_ID=
ONCALL_FEISHU_APP_SECRET=
ONCALL_FEISHU_DEFAULT_RECEIVE_ID=
ONCALL_FEISHU_DEFAULT_RECEIVE_ID_TYPE=chat_id

# Internal infrastructure and image acceleration.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
ONCALL_WEB_PORT=3000
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16
ETCD_IMAGE=registry.cn-hangzhou.aliyuncs.com/mdpublic/mingdaoyun-etcd:v3.5.25
MINIO_IMAGE=docker.m.daocloud.io/minio/minio:RELEASE.2025-07-23T15-54-02Z
MILVUS_IMAGE=docker.m.daocloud.io/milvusdb/milvus:v2.6.3
